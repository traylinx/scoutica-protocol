---
const { title } = Astro.props;
---
<details class="sc-expandable">
  <summary>{title}</summary>
  <div class="sc-expandable-body"><slot /></div>
</details>
<style>
.sc-expandable{border-inline-start:2px solid var(--sl-color-gray-5);padding:.2rem 0 .2rem .8rem;margin:.4rem 0;}
.sc-expandable>summary{cursor:pointer;font-weight:500;}
</style>
