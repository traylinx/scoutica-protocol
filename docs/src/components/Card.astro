---
const { title, href, icon } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="sc-card" href={href}>
  {title && <span class="sc-card-title">{title}</span>}
  <span class="sc-card-body"><slot /></span>
</Tag>
<style>
.sc-card{display:block;border:1px solid var(--sl-color-gray-5);border-radius:.6rem;padding:1rem 1.1rem;text-decoration:none;color:inherit;background:var(--sl-color-gray-7,transparent);transition:border-color .15s;}
a.sc-card:hover{border-color:var(--sl-color-accent);}
.sc-card-title{display:block;font-weight:600;color:var(--sl-color-white);margin-bottom:.35rem;}
.sc-card-body{display:block;font-size:.92rem;color:var(--sl-color-gray-2);}
</style>
