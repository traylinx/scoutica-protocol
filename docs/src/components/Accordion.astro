---
const { title } = Astro.props;
---
<details class="sc-accordion">
  <summary>{title}</summary>
  <div class="sc-accordion-body"><slot /></div>
</details>
<style>
.sc-accordion{border:1px solid var(--sl-color-gray-5);border-radius:.5rem;padding:.4rem .8rem;background:var(--sl-color-gray-7,transparent);}
.sc-accordion>summary{cursor:pointer;font-weight:600;padding:.3rem 0;}
.sc-accordion-body{padding:.3rem 0 .5rem;}
</style>
