#!/bin/sh
# Environment-driven AI-provider double. Reads stdin, records process state, and emits mock output.

set -u

if [ -n "${FAKE_PROVIDER_COUNT_FILE:-}" ]; then
    _fake_count=0
    if [ -f "$FAKE_PROVIDER_COUNT_FILE" ]; then
        _fake_count=$(cat "$FAKE_PROVIDER_COUNT_FILE" 2>/dev/null || printf '0')
    fi
    case "$_fake_count" in ''|*[!0-9]*) _fake_count=0 ;; esac
    _fake_count=$((_fake_count + 1))
    printf '%s\n' "$_fake_count" > "$FAKE_PROVIDER_COUNT_FILE"
fi

if [ -n "${FAKE_PROVIDER_PID_FILE:-}" ]; then
    printf '%s\n' "$$" > "$FAKE_PROVIDER_PID_FILE"
fi

_fake_signal() {
    if [ -n "${FAKE_PROVIDER_SIGNAL_FILE:-}" ]; then
        printf '%s\n' "$1" > "$FAKE_PROVIDER_SIGNAL_FILE"
    fi
}
trap '_fake_signal INT; exit 130' INT
trap '_fake_signal TERM; exit 143' TERM

if [ -n "${FAKE_PROVIDER_ARGV_LOG:-}" ]; then
    : > "$FAKE_PROVIDER_ARGV_LOG"
    for _fake_arg in "$@"; do
        printf '%s\n' "$_fake_arg" >> "$FAKE_PROVIDER_ARGV_LOG"
    done
fi

if [ -n "${FAKE_PROVIDER_READY_FILE:-}" ]; then
    : > "$FAKE_PROVIDER_READY_FILE"
fi

if [ -n "${FAKE_PROVIDER_FORK_PID_FILE:-}" ]; then
    sleep 20 &
    printf '%s\n' "$!" > "$FAKE_PROVIDER_FORK_PID_FILE"
fi

if [ -n "${FAKE_PROVIDER_RELEASE_FILE:-}" ]; then
    while [ ! -e "$FAKE_PROVIDER_RELEASE_FILE" ]; do
        sleep 0.05
    done
fi

if [ -n "${FAKE_PROVIDER_STDIN_LOG:-}" ]; then
    cat > "$FAKE_PROVIDER_STDIN_LOG"
else
    cat >/dev/null
fi

if [ -n "${FAKE_PROVIDER_RESPONSE_FILE:-}" ]; then
    if [ -n "${FAKE_PROVIDER_OUTPUT_FILE:-}" ]; then
        cp "$FAKE_PROVIDER_RESPONSE_FILE" "$FAKE_PROVIDER_OUTPUT_FILE"
    else
        cat "$FAKE_PROVIDER_RESPONSE_FILE"
    fi
elif [ -n "${FAKE_PROVIDER_RESPONSE:-}" ]; then
    if [ -n "${FAKE_PROVIDER_OUTPUT_FILE:-}" ]; then
        printf '%s\n' "$FAKE_PROVIDER_RESPONSE" > "$FAKE_PROVIDER_OUTPUT_FILE"
    else
        printf '%s\n' "$FAKE_PROVIDER_RESPONSE"
    fi
fi

exit "${FAKE_PROVIDER_EXIT:-0}"
