# ─── Helpers ──────────────────────────────────────────────────────────────────

header() {
    echo ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}   ⚡ Scoutica Protocol — $1${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════╝${NC}"
    echo ""
}

ask() {
    local prompt="$1"
    local default="${2:-}"
    local result=""
    
    if [ -n "$default" ]; then
        echo -ne "  ${BOLD}$prompt${NC} ${DIM}[$default]${NC}: " >&2
        read -r result
        echo "${result:-$default}"
    else
        echo -ne "  ${BOLD}$prompt${NC}: " >&2
        read -r result
        echo "$result"
    fi
}

ask_list() {
    local prompt="$1"
    local hint="${2:-comma-separated}"
    echo -ne "  ${BOLD}$prompt${NC} ${DIM}($hint)${NC}: " >&2
    read -r result
    echo "$result"
}

ask_choice() {
    local prompt="$1"
    shift
    local options=("$@")
    
    echo -e "  ${BOLD}$prompt${NC}" >&2
    for i in "${!options[@]}"; do
        echo -e "    ${CYAN}$((i+1)))${NC} ${options[$i]}" >&2
    done
    while true; do
        echo -ne "  ${BOLD}Choose${NC} ${DIM}[1-${#options[@]}]${NC}: " >&2
        read -r choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#options[@]}" ]; then
            echo "${options[$((choice-1))]}"
            return
        fi
        echo -e "  ${YELLOW}Invalid choice. Try again.${NC}" >&2
    done
}

confirm() {
    local prompt="$1"
    # Prompt to stderr (not stdout) so `bool=$(confirm ...)` captures only the y/N result,
    # never the prompt text (F-MED-CONFIRM-001). read still uses the terminal via stdin.
    echo -ne "  ${BOLD}$prompt${NC} ${DIM}[y/N]${NC}: " >&2
    read -r answer
    [[ "$answer" =~ ^[Yy] ]]
}

# _validate_url <url> : 0 if safe to fetch, 1 otherwise (reason on stderr). Enforces HTTPS and
# blocks localhost / private / link-local / reserved / metadata hosts. Fails CLOSED on DNS failure
# or an unresolvable host. Used for BOTH the user URL and any discovered card_url (F-HIGH-SSRF-001).
_validate_url() {
    local u="$1"
    if ! printf '%s' "$u" | grep -qE '^https://'; then
        error "Only HTTPS URLs are supported (got: $u)"
        return 1
    fi
    local out
    out=$(python3 - "$u" <<'VALIDATE_URL' 2>/dev/null
import sys, ipaddress, socket
from urllib.parse import urlparse
_pu = urlparse(sys.argv[1])
host = (_pu.hostname or '').lower()
port = _pu.port or 443
if not host:
    print('BLOCKED:no-host'); sys.exit(0)
if host in ('localhost', 'ip6-localhost', 'ip6-loopback'):
    print('BLOCKED:localhost'); sys.exit(0)
def blocked(ipstr):
    try:
        ip = ipaddress.ip_address(ipstr)
    except ValueError:
        return False
    return (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved
            or ip.is_multicast or ip.is_unspecified)
# literal-IP host: allow only if it is a public address
try:
    ipaddress.ip_address(host)
    print('BLOCKED:literal-ip' if blocked(host) else 'OK %s %d %s' % (host, port, host)); sys.exit(0)
except ValueError:
    pass
# hostname: resolve and fail CLOSED on any failure or private answer
try:
    addrs = socket.getaddrinfo(host, None)
except Exception:
    print('BLOCKED:dns-failure'); sys.exit(0)
ips = [s[4][0] for s in addrs]
if not ips:
    print('BLOCKED:no-address'); sys.exit(0)
for ip in ips:
    if blocked(ip):
        print('BLOCKED:private-resolution'); sys.exit(0)
v4 = [ip for ip in ips if ':' not in ip]
print('OK %s %d %s' % (host, port, v4[0] if v4 else ips[0]))
VALIDATE_URL
)
    if [ "${out%% *}" != "OK" ]; then
        error "Refusing to fetch unsafe URL (${out:-validation-failed}): $u"
        return 1
    fi
    # Echo the validated IP so callers can pin curl (--resolve) against DNS rebinding.
    printf '%s\n' "${out#OK }"
    return 0
}

# _refuse_if_symlink <path...> : shared symlink-safe write guard. Call before writing any card,
# state, org, role, or identity file so a pre-planted symlink cannot redirect the write (F-HIGH-FS-001).
_refuse_if_symlink() {
    local _p
    for _p in "$@"; do
        if [ -L "$_p" ]; then
            error "Refusing to write through symlink: $_p"
            return 1
        fi
    done
    return 0
}

_git_publish_path_allowed() {
    local _publish_kind="$1" _publish_path="$2" _publish_leaf
    case "$_publish_kind:$_publish_path" in
        candidate:profile.json|candidate:rules.yaml|candidate:evidence.json|candidate:SKILL.md|candidate:scoutica.json|candidate:README.md|candidate:.gitignore|candidate:rules/evaluate-fit.md|candidate:rules/negotiate-terms.md|candidate:rules/verify-evidence.md|candidate:rules/request-interview.md)
            return 0
            ;;
        employer:recruiter_profile.json|employer:hiring_rules.yaml)
            return 0
            ;;
        employer:roles/*.json)
            _publish_leaf=${_publish_path#roles/}
            case "$_publish_leaf" in */*) return 1 ;; *) return 0 ;; esac
            ;;
    esac
    return 1
}

# Refuse publication if the current index contains anything outside the command's canonical set.
# This helper is read-only, so a pre-stage refusal leaves .git/index byte-for-byte unchanged.
_git_require_canonical_index() {
    local _publish_kind="$1" _publish_phase="$2" _publish_list _publish_path _publish_bad=0
    _publish_list=$(mktemp "${TMPDIR:-/tmp}/scoutica-staged.XXXXXX") || {
        error "Could not inspect the Git index."
        return 1
    }
    if ! git diff --cached --name-only -z -- > "$_publish_list"; then
        rm -f "$_publish_list"
        error "Could not inspect the Git index."
        return 1
    fi
    while IFS= read -r -d '' _publish_path; do
        if ! _git_publish_path_allowed "$_publish_kind" "$_publish_path"; then
            if [ "$_publish_bad" -eq 0 ]; then
                error "Refusing to publish: $_publish_phase staged paths outside the canonical $_publish_kind allowlist:"
            fi
            printf '    %q\n' "$_publish_path" >&2
            _publish_bad=1
        fi
    done < "$_publish_list"
    rm -f "$_publish_list"
    [ "$_publish_bad" -eq 0 ]
}

_git_stage_canonical_paths() {
    local _publish_kind="$1" _publish_path
    case "$_publish_kind" in
        candidate)
            for _publish_path in profile.json rules.yaml evidence.json SKILL.md scoutica.json README.md .gitignore \
                rules/evaluate-fit.md rules/negotiate-terms.md rules/verify-evidence.md rules/request-interview.md; do
                [ -f "$_publish_path" ] || continue
                git add -- "$_publish_path" || return 1
            done
            ;;
        employer)
            for _publish_path in recruiter_profile.json hiring_rules.yaml; do
                [ -f "$_publish_path" ] || continue
                git add -- "$_publish_path" || return 1
            done
            for _publish_path in roles/*.json; do
                [ -f "$_publish_path" ] || continue
                git add -- "$_publish_path" || return 1
            done
            ;;
        *) return 2 ;;
    esac
}

# Promote a validated generated card into its final directory. Validation must
# happen before this helper is called; Phase 3 upgrades these bounded copies to
# atomic no-follow writes.
_promote_generated_card() {
    local _stage="$1" _destination="$2" _generated_file
    _refuse_if_symlink \
        "$_destination" "$_destination/rules" \
        "$_destination/profile.json" "$_destination/rules.yaml" \
        "$_destination/evidence.json" "$_destination/SKILL.md" \
        "$_destination/README.md" "$_destination/.gitignore" || return 1

    mkdir -p "$_destination/rules" || return 1
    for _generated_file in profile.json rules.yaml evidence.json SKILL.md README.md; do
        [ -f "$_stage/$_generated_file" ] || continue
        cp "$_stage/$_generated_file" "$_destination/$_generated_file" || return 1
    done
    if [ -d "$_stage/rules" ]; then
        cp "$_stage/rules/"*.md "$_destination/rules/" 2>/dev/null || true
    fi
    if [ ! -f "$_destination/.gitignore" ] && [ -f "$_stage/.gitignore" ]; then
        cp "$_stage/.gitignore" "$_destination/.gitignore" || return 1
    fi
}

# Print a supported Python executable. Scoutica's strict runtime starts at 3.11.
_supported_python() {
    local _python
    for _python in python3.13 python3.12 python3.11 python3 python; do
        if command -v "$_python" >/dev/null 2>&1 \
            && "$_python" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
            printf '%s\n' "$_python"
            return 0
        fi
    done
    return 1
}

_python_has_strict_validation_deps() {
    "$1" - <<'PY' >/dev/null 2>&1
import sys
import yaml
from jsonschema import FormatChecker
from jsonschema.exceptions import FormatError

if sys.version_info < (3, 11):
    raise SystemExit(1)
checker = FormatChecker()
for format_name, invalid_value in (
    ("uri", "not a uri"),
    ("hostname", "bad host!"),
    ("date", "not-date"),
    ("date-time", "not-date-time"),
):
    if format_name not in checker.checkers:
        raise SystemExit(1)
    try:
        checker.check(invalid_value, format_name)
    except FormatError:
        continue
    raise SystemExit(1)
PY
}

_supported_validation_python() {
    local _python
    for _python in python3.13 python3.12 python3.11 python3 python; do
        if command -v "$_python" >/dev/null 2>&1 \
            && _python_has_strict_validation_deps "$_python"; then
            printf '%s\n' "$_python"
            return 0
        fi
    done
    return 1
}

_python_prerequisite_guidance() {
    echo -e "  ${DIM}Install Python 3.11+, then run: python3 -m pip install 'jsonschema[format]' PyYAML${NC}" >&2
}

# Resolve a schema only from the installed bundle or this checkout, never from cwd.
_find_schema_file() {
    local _schema_rel="$1"
    local _schema_script_dir _schema_path
    _schema_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    for _schema_path in \
        "$_schema_script_dir/../schemas/$_schema_rel" \
        "$_schema_script_dir/schemas/$_schema_rel"; do
        if [ -f "$_schema_path" ]; then
            printf '%s\n' "$_schema_path"
            return 0
        fi
    done
    return 1
}

# Export VALIDATION_PYTHON for generation/validation commands without mutating global Python.
_require_validation_runtime() {
    VALIDATION_PYTHON=$(_supported_validation_python) || {
        local _version_python=""
        _version_python=$(_supported_python) || true
        if [ -n "$_version_python" ]; then
            error "Missing required Python dependencies: jsonschema[format] and PyYAML."
            _python_prerequisite_guidance
            return 1
        fi
        error "Python 3.11+ is required."
        _python_prerequisite_guidance
        return 1
    }
    export VALIDATION_PYTHON
}

