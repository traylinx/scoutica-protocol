cmd_jobs() {
    local subcommand="${1:-help}"
    shift 2>/dev/null || true
    
    case "$subcommand" in
        search) cmd_jobs_search "$@" ;;
        *)
            echo ""
            echo -e "${BOLD}scoutica jobs${NC} — Network Discovery"
            echo ""
