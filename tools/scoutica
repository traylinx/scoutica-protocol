SCOUTICA_HOME="${SCOUTICA_HOME:-$HOME/.scoutica}"
SCHEMAS_DIR="$SCOUTICA_HOME/schemas"
TEMPLATES_DIR="$SCOUTICA_HOME/templates"
STATE_DIR=".scoutica"
STATE_FILE="$STATE_DIR/state.json"
REGISTRY_FILE="$SCOUTICA_HOME/registry.json"
LOGS_DIR="$SCOUTICA_HOME/logs"
CACHE_DIR="$SCOUTICA_HOME/cache"

