}

cmd_identity_init() {
    header "Generate Nostr Identity"
    
    local identity_dir="$HOME/.scoutica/identity"
    
    if [ -f "$identity_dir/keypair.json" ]; then
        warn "Identity already exists at $identity_dir/keypair.json"
        if ! confirm "Overwrite existing identity?"; then
            echo -e "  ${DIM}Keeping existing identity.${NC}"
            return 0
        fi
    fi
    
    _refuse_if_symlink "$identity_dir" "$identity_dir/keypair.json" "$identity_dir/public.json" || exit 1
    if python3 - "$identity_dir" <<'IDENTITY_SCRIPT'
import json, sys, os, secrets
from datetime import datetime, timezone

identity_dir = sys.argv[1]

# bech32 (BIP-0173) encoder — a deterministic encoding, not cryptography.
_CHARSET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
def _polymod(values):
    gen = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3]
    chk = 1
    for v in values:
        b = chk >> 25
        chk = ((chk & 0x1ffffff) << 5) ^ v
        for i in range(5):
            chk ^= gen[i] if ((b >> i) & 1) else 0
    return chk
def _hrp_expand(hrp):
    return [ord(x) >> 5 for x in hrp] + [0] + [ord(x) & 31 for x in hrp]
def _convertbits(data):
    acc = 0; bits = 0; out = []
    for b in data:
        acc = (acc << 8) | b; bits += 8
        while bits >= 5:
            bits -= 5; out.append((acc >> bits) & 31)
    if bits:
        out.append((acc << (5 - bits)) & 31)
    return out
def bech32(hrp, raw):
    data = _convertbits(list(raw))
    poly = _polymod(_hrp_expand(hrp) + data + [0] * 6) ^ 1
    chk = [(poly >> 5 * (5 - i)) & 31 for i in range(6)]
    return hrp + "1" + "".join(_CHARSET[d] for d in data + chk)

# Real secp256k1 keypair, or refuse — NEVER emit hash-derived placeholder keys.
try:
    from coincurve import PrivateKey
except Exception:
    sys.exit(3)

sk = PrivateKey(secrets.token_bytes(32))
priv = sk.secret                                  # 32-byte private key
xonly = sk.public_key.format(compressed=True)[1:]  # 32-byte x-only Nostr pubkey
npub = bech32("npub", xonly)
nsec = bech32("nsec", priv)
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
relays = ["wss://relay.damus.io", "wss://relay.nostr.band", "wss://nos.lol"]

os.makedirs(identity_dir, mode=0o700, exist_ok=True)
os.chmod(identity_dir, 0o700)

keypair_file = os.path.join(identity_dir, "keypair.json")
_keydata = {"created_at": now, "algorithm": "secp256k1",
            "public_key_hex": xonly.hex(), "npub": npub,
            "private_key_hex": priv.hex(), "nsec": nsec,
            "default_relays": relays}
# Race-free private-key write: mkstemp makes a fresh 0600 file (never following a symlink),
# fchmod to be certain, write, then atomically replace keypair.json (no O_TRUNC-follows-symlink,
# no loose-perms window on overwrite).
import tempfile
_fd, _tmp = tempfile.mkstemp(dir=identity_dir, prefix=".keypair.", suffix=".tmp")
try:
    os.fchmod(_fd, 0o600)
    with os.fdopen(_fd, "w") as f:
        json.dump(_keydata, f, indent=2)
        f.write("\n")
    os.replace(_tmp, keypair_file)
except BaseException:
    try:
        os.unlink(_tmp)
    except OSError:
        pass
    raise

with open(os.path.join(identity_dir, "public.json"), "w") as f:
    json.dump({"public_key_hex": xonly.hex(), "npub": npub,
               "default_relays": relays, "created_at": now}, f, indent=2)
    f.write("\n")

print("  ✅ Nostr identity generated (real secp256k1).")
print()
print("  \U0001f511 Public key (share this): " + npub)
print("  \U0001f512 Private key stored at " + keypair_file + " (mode 600) — NEVER share it.")
print("  \U0001f4e1 Default relays: " + ", ".join(relays))
IDENTITY_SCRIPT
    then
        :
    else
        _rc=$?
        if [ "$_rc" -eq 3 ]; then
            error "Cannot generate a real Nostr identity: no secp256k1 library is available."
            echo -e "  ${DIM}Scoutica refuses to write placeholder/hash-derived keys — they are NOT valid Nostr${NC}" >&2
            echo -e "  ${DIM}keys and would fake a working identity. Install a real library and retry, e.g.:${NC}" >&2
            echo -e "  ${CYAN}pip install coincurve${NC}" >&2
        else
            error "Identity generation failed (exit $_rc)."
        fi
        exit 1
    fi
    
    echo ""
}

