                            error "Commit failed. No publish was recorded."
                            return 1
                        fi
                        if ! git branch -M main >/dev/null 2>&1; then
                            error "Failed to prepare the main branch."
                            return 1
                        fi
                        
                        # Create repo on GitHub automatically
                        echo -e "  ${DIM}Creating repository ${BOLD}$gh_user/$repo_name${NC} ${DIM}on GitHub...${NC}"
                        if gh repo create "$repo_name" --public --source=. --remote=origin --push >/dev/null 2>&1; then
                            echo -e "  ${GREEN}✅ Successfully published to GitHub!${NC}"
                            echo ""
                            
