#!/usr/bin/env bash
# ============================================================================
# Scoutica Protocol CLI — Your Skills. Your Rules. Your Data.
#
# Candidate Commands:
#   scoutica scan <folder>  Auto-generate card from your documents (AI-powered)
#   scoutica init           Interactive wizard to create your Skill Card
#   scoutica init --ai      Generate card using AI (paste GENERATE_MY_CARD.md)
#   scoutica validate       Validate your card against protocol schemas
#   scoutica publish        Push your card to GitHub
#   scoutica resolve <url>  Fetch and display any card from a URL
#   scoutica info           Show card summary
#   scoutica logs           View scan logs and timing data
#
# Employer Commands:
#   scoutica org init       Create a Recruiter/Employer Identity Card
#   scoutica org verify     Verify domain ownership (DNS TXT)
#   scoutica org publish    Push employer card to GitHub
#   scoutica role create    Create a structured job posting (role.json)
#   scoutica role validate  Validate role against protocol schemas
#
# Network Commands:
#   scoutica evaluate       Deterministic fit scoring (candidate vs role)
#   scoutica jobs search    Search the registry for candidates or roles
#   scoutica send           Send a message to another agent
#   scoutica inbox          Check for incoming messages
#   scoutica reply          Accept/reject/withdraw a message
#   scoutica deliver        Push pending messages to recipients
#   scoutica register       Generate registry entry for PR submission
#   scoutica identity init  Generate a Nostr keypair (secp256k1)
#
# System Commands:
#   scoutica update         Update the CLI to the latest version
#   scoutica doctor         System diagnostics and health check
#   scoutica help           Show this help
# ============================================================================

set -euo pipefail

