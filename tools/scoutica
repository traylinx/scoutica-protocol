            echo -e "  ${BOLD}View on GitHub:${NC}"
            echo -e "  $clean_url"
            echo ""
            echo -e "  ${BOLD}Test your live card:${NC}"
            echo -e "  ${CYAN}scoutica resolve $clean_url${NC}"

            local abs_card_dir
            abs_card_dir=$(pwd)
            _register_card "$abs_card_dir" "publish" '{"github_url": "'"$clean_url"'"}'
        )
        return $?
    else
        # ── No git repo — smart setup ──────────────────────────────────
        
        # Try to extract a sensible default repo name from profile.json
        local default_repo="my-scoutica-card"
        if [ -f "$card_dir/profile.json" ] && command -v python3 &>/dev/null; then
