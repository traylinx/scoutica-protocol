    role_schema=$(_find_schema_file "recruiter/role.schema.json") || {
        error "Role schema not found. Re-run the installer."
        return 1
    }
    
    mkdir -p "$target_dir" || {
        error "Could not create role target directory: $target_dir"
        return 1
    }
    _refuse_if_symlink "$target_dir" "$target_dir/roles" || return 1
    if [ -e "$target_dir/roles" ] && [ ! -d "$target_dir/roles" ]; then
        error "Role output parent is not a directory: $target_dir/roles"
        return 1
    fi
    mkdir -p "$target_dir/roles" || {
        error "Could not create role output directory: $target_dir/roles"
        return 1
    }
    _refuse_if_symlink "$target_dir" "$target_dir/roles" || return 1
    
    "$VALIDATION_PYTHON" << 'ROLE_GENERATE_SCRIPT' - \
        "$target_dir" \
        "$role_title" "$role_description" "$role_seniority" "$min_years" \
        "$hard_skills" "$preferred_skills" "$soft_skills" "$languages_required" \
        "$currency" "$base_min" "$base_max" "$equity" \
        "$location_type" "$regions" "$tz_overlap" "$office_location" \
        "$engagement_type" "$start_date" "$duration_months" \
        "$recruiter_card_url" "$role_schema"
import json, sys, os, re, hashlib, jsonschema, secrets, stat
from datetime import datetime, timezone, timedelta

args = sys.argv[1:]
target_dir = args[0]
role_title, role_desc, seniority, min_years_str = args[1:5]
hard_csv, preferred_csv, soft_csv, languages_csv = args[5:9]
currency, base_min_str, base_max_str, equity_str = args[9:13]
location_type, regions_csv, tz_overlap, office_loc = args[13:17]
engagement_type, start_date, duration_str = args[17:20]
recruiter_card_url = args[20] if len(args) > 20 else ""
role_schema_path = args[21]

def csv_to_list(s):
    return [x.strip() for x in s.split(',') if x.strip()] if s else []

def safe_int(s, default=0):
    try: return int(s)
    except: return default

now = datetime.now(timezone.utc)
expiry = now + timedelta(days=30)

# Generate a deterministic job_id from title
title_hash = hashlib.sha256(f"{role_title}:{now.isoformat()}".encode()).hexdigest()[:6]
job_id = f"req_{title_hash}"

role = {
    "scoutica_version": "0.3.0",
    "job_id": job_id,
    "title": role_title,
    "status": "active",
    "posted_at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "expires_at": expiry.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "refreshed_at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "requirements": {
        "hard_skills": csv_to_list(hard_csv),
        "seniority": seniority,
        "minimum_years_experience": safe_int(min_years_str, 5),
    },
    "compensation": {
        "currency": currency.upper(),
        "base_min": safe_int(base_min_str, 80000),
        "base_max": safe_int(base_max_str, 120000),
        "equity_offered": equity_str == "true",
    },
    "location": {
        "type": location_type,
    },
    "engagement": {
        "type": "contract" if engagement_type == "freelance" else engagement_type,
    },
    "description": role_desc,
}

# Optional fields
if csv_to_list(preferred_csv):
    role["requirements"]["preferred_skills"] = csv_to_list(preferred_csv)
if csv_to_list(soft_csv):
    role["requirements"]["soft_skills"] = csv_to_list(soft_csv)
if csv_to_list(languages_csv):
    role["requirements"]["languages_required"] = csv_to_list(languages_csv)
if csv_to_list(regions_csv):
    role["location"]["regions_allowed"] = csv_to_list(regions_csv)
if tz_overlap:
    role["location"]["timezone_overlap_required"] = tz_overlap
if office_loc:
    role["location"]["office_location"] = office_loc
if start_date:
    role["engagement"]["start_date"] = start_date
if duration_str:
    role["engagement"]["duration_months"] = safe_int(duration_str)
if recruiter_card_url:
    role["recruiter_card_url"] = recruiter_card_url

# Generate filename from title
filename = re.sub(r'[^a-z0-9]+', '-', role_title.lower()).strip('-') + '.json'
filepath = os.path.join(target_dir, 'roles', filename)

# Validate the complete role against the canonical schema before persistence or success output.
with open(role_schema_path, encoding="utf-8") as f:
    role_schema = json.load(f)
jsonschema.Draft7Validator.check_schema(role_schema)
jsonschema.validate(role, role_schema, format_checker=jsonschema.FormatChecker())

def write_role_atomic():
    required_flags = ("O_DIRECTORY", "O_NOFOLLOW")
    if any(not hasattr(os, flag) for flag in required_flags):
        raise RuntimeError("platform lacks required no-follow directory operations")

    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    target_fd = None
    roles_fd = None
    temp_name = None
    try:
        target_fd = os.open(target_dir, directory_flags)
        roles_fd = os.open("roles", directory_flags, dir_fd=target_fd)
        target_identity = os.fstat(target_fd)
        roles_identity = os.fstat(roles_fd)
        if not stat.S_ISDIR(target_identity.st_mode) or not stat.S_ISDIR(roles_identity.st_mode):
            raise RuntimeError("role target or roles parent is not a directory")

        try:
            final_state = os.stat(filename, dir_fd=roles_fd, follow_symlinks=False)
        except FileNotFoundError:
            final_state = None
        if final_state is not None and stat.S_ISLNK(final_state.st_mode):
            raise RuntimeError(f"refusing symlinked role output: {filepath}")
        if final_state is not None and not stat.S_ISREG(final_state.st_mode):
            raise RuntimeError(f"role output is not a regular file: {filepath}")

        for _ in range(100):
            candidate = f".scoutica-role-{os.getpid()}-{secrets.token_hex(8)}.tmp"
            try:
                temp_fd = os.open(
                    candidate,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                    0o600,
                    dir_fd=roles_fd,
                )
                temp_name = candidate
                break
            except FileExistsError:
                continue
        else:
            raise RuntimeError("could not allocate a unique role temporary")

        os.fchmod(temp_fd, 0o600)
        with os.fdopen(temp_fd, "w", encoding="utf-8") as handle:
            json.dump(role, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())

        current_target = os.stat(target_dir, follow_symlinks=False)
        current_roles = os.stat(os.path.join(target_dir, "roles"), follow_symlinks=False)
        if stat.S_ISLNK(current_target.st_mode) or stat.S_ISLNK(current_roles.st_mode):
            raise RuntimeError("role target or roles parent became a symlink")
        if (current_target.st_dev, current_target.st_ino) != (target_identity.st_dev, target_identity.st_ino):
            raise RuntimeError("role target directory changed during write")
        if (current_roles.st_dev, current_roles.st_ino) != (roles_identity.st_dev, roles_identity.st_ino):
            raise RuntimeError("roles parent changed during write")

        try:
            final_state = os.stat(filename, dir_fd=roles_fd, follow_symlinks=False)
        except FileNotFoundError:
            final_state = None
        if final_state is not None and stat.S_ISLNK(final_state.st_mode):
            raise RuntimeError(f"refusing symlinked role output: {filepath}")
        if final_state is not None and not stat.S_ISREG(final_state.st_mode):
            raise RuntimeError(f"role output is not a regular file: {filepath}")

        os.replace(temp_name, filename, src_dir_fd=roles_fd, dst_dir_fd=roles_fd)
        temp_name = None
        os.fsync(roles_fd)
    finally:
        if temp_name is not None and roles_fd is not None:
            try:
                os.unlink(temp_name, dir_fd=roles_fd)
            except FileNotFoundError:
                pass
        if roles_fd is not None:
            os.close(roles_fd)
        if target_fd is not None:
            os.close(target_fd)

try:
    write_role_atomic()
except (OSError, RuntimeError) as exc:
    print(f"  ❌ Refusing unsafe role write: {exc}", file=sys.stderr)
    sys.exit(1)
print(f"  ✅ Created roles/{filename}")
print(f"     Job ID: {job_id}")
print(f"     Expires: {expiry.strftime('%Y-%m-%d')} (30 days — refresh to prevent ghost-job decay)")
ROLE_GENERATE_SCRIPT
    
    echo ""
    echo -e "  ${BOLD}Next steps:${NC}"
    echo -e "  ${CYAN}scoutica role validate${NC}    Validate against protocol schemas"
    echo -e "  ${CYAN}scoutica org publish${NC}      Push to GitHub"
    echo ""
}

