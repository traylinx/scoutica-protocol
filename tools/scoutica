    echo ""
}

# ─── Main Router ──────────────────────────────────────────────────────────────

cmd_import() {
    # scoutica import <source-type> <src-dir> [--to <dir>] [--salary-floor-eur N] [--force]
    # Deterministic, OFFLINE bridge from an ai-job-search fork to a Scoutica Skill Card.
    # Delegates all parsing/emission to import_aijs.py; every value is passed as a distinct argv
    # element (never interpolated into a python -c string), so untrusted source text stays inert.
    local source_type="${1:-}"
    shift 2>/dev/null || true
    if [ "$source_type" != "aijs" ]; then
        error "Unknown import source: '${source_type:-}'. Supported: aijs (ai-job-search fork)"
        echo "  Usage: scoutica import aijs <fork-dir> [--to <dir>] [--salary-floor-eur N] [--force]"
        return 1
    fi
    local src="" target="." floor="" force=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --to)               target="$2"; shift 2 ;;
            --salary-floor-eur) floor="$2"; shift 2 ;;
            --force)            force="--force"; shift ;;
            -*)                 error "Unknown flag: $1"; return 1 ;;
            *)                  [ -z "$src" ] && src="$1"; shift ;;
        esac
    done
    if [ -z "$src" ]; then
        error "Missing source directory. Usage: scoutica import aijs <fork-dir> [--to <dir>]"
        return 1
    fi
    local script_dir importer
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$script_dir/import_aijs.py" ]; then importer="$script_dir/import_aijs.py"
    elif [ -f "$SCOUTICA_HOME/bin/import_aijs.py" ]; then importer="$SCOUTICA_HOME/bin/import_aijs.py"
    elif [ -f "$SCOUTICA_HOME/tools/import_aijs.py" ]; then importer="$SCOUTICA_HOME/tools/import_aijs.py"
    else error "Importer not found (import_aijs.py). Re-run the installer."; return 1; fi
    local python_cmd
    python_cmd="$(command -v python3 || command -v python)"
    if [ -z "$python_cmd" ]; then error "Python 3 is required for import"; return 1; fi
    # Non-TTY (piped / CI) fails closed on an unresolvable required enum; a real TTY lets it prompt.
    local tty=0; [ -t 0 ] && tty=1
    if [ -n "$floor" ]; then
        "$python_cmd" "$importer" --src "$src" --to "$target" --tty "$tty" --salary-floor-eur "$floor" $force
    else
        "$python_cmd" "$importer" --src "$src" --to "$target" --tty "$tty" $force
    fi
}

main() {
    local command="${1:-help}"
    shift 2>/dev/null || true
    
    case "$command" in
        init)       cmd_init "$@" ;;
        import)     cmd_import "$@" ;;
        scan)       cmd_scan "$@" ;;
        resolve)    cmd_resolve "$@" ;;
        validate)   cmd_validate "$@" ;;
        publish)    cmd_publish "$@" ;;
        info)       cmd_info "$@" ;;
        preview)    cmd_preview "$@" ;;
        update)     cmd_update "$@" ;;
        doctor)     cmd_doctor "$@" ;;
        status)     cmd_status "$@" ;;
        logs)       cmd_logs "$@" ;;
        org)        cmd_org "$@" ;;
        role)       cmd_role "$@" ;;
        evaluate)   cmd_evaluate "$@" ;;
        jobs)       cmd_jobs "$@" ;;
        send)       cmd_send "$@" ;;
        inbox)      cmd_inbox "$@" ;;
        reply)      cmd_reply "$@" ;;
        deliver)    cmd_deliver "$@" ;;
        register)   cmd_register "$@" ;;
        identity)   cmd_identity "$@" ;;
        help|--help|-h)  cmd_help ;;
        version|--version|-v) echo "scoutica v$VERSION" ;;
        *)
            error "Unknown command: $command"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
