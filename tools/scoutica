# ─── State Management ─────────────────────────────────────────────────────────

_compute_source_hash() {
    local dir="$1"
    local hash_input=""
    for file in "$dir"/*; do
        [ -f "$file" ] || continue
        local bn=$(basename "$file")
        case "$bn" in
            profile.json|rules.yaml|evidence.json|SKILL.md|scoutica_prompt.txt|scoutica.json) continue ;;
        esac
        local ext="${bn##*.}"
        ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
        case "$ext" in
            md|txt|json|yaml|yml|csv|html|htm|pdf|docx)
                hash_input+=$(shasum -a 256 "$file" 2>/dev/null | awk '{print $1}')
                ;;
        esac
    done
    echo -n "$hash_input" | shasum -a 256 | awk '{print $1}'
}

_compute_card_hash() {
    local dir="$1"
    local hash_input=""
    for f in profile.json rules.yaml evidence.json SKILL.md; do
        [ -f "$dir/$f" ] && hash_input+=$(shasum -a 256 "$dir/$f" 2>/dev/null | awk '{print $1}')
    done
    echo -n "$hash_input" | shasum -a 256 | awk '{print $1}'
}

_scan_runtime_helper() {
    local helper_dir helper_path
    helper_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    for helper_path in \
        "$helper_dir/scan_runtime.py" \
        "$SCOUTICA_HOME/bin/scan_runtime.py" \
        "$SCOUTICA_HOME/tools/scan_runtime.py"; do
        if [ -f "$helper_path" ]; then
            printf '%s\n' "$helper_path"
            return 0
        fi
    done
    return 1
}

_read_state() {
    local card_dir="$1" key="$2" helper state_python="${VALIDATION_PYTHON:-}"
    helper=$(_scan_runtime_helper) || return 1
    [ -n "$state_python" ] || state_python=$(_supported_python) || return 1
    "$state_python" "$helper" state-get --card-dir "$card_dir" --key "$key" 2>/dev/null
}

_write_preview_state() {
    local card_dir="$1" url="$2" card_hash="$3" helper now expires state_python="${VALIDATION_PYTHON:-}"
    helper=$(_scan_runtime_helper) || {
        error "Scan runtime helper not found. Re-run the installer."
        return 1
    }
    [ -n "$state_python" ] || state_python=$(_supported_python) || return 1
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    expires=$("$state_python" -c "from datetime import datetime,timedelta,timezone;print((datetime.now(timezone.utc)+timedelta(hours=24)).strftime('%Y-%m-%dT%H:%M:%SZ'))") || return 1
    "$state_python" "$helper" state-preview \
        --card-dir "$card_dir" --url "$url" --published-at "$now" \
        --expires-at "$expires" --card-hash "$card_hash"
}

_write_resolve_state() {
    local card_dir="$1" url="$2" helper state_python="${VALIDATION_PYTHON:-}"
    helper=$(_scan_runtime_helper) || {
        error "Scan runtime helper not found. Re-run the installer."
        return 1
    }
    [ -n "$state_python" ] || state_python=$(_supported_python) || return 1
    "$state_python" "$helper" state-resolve --card-dir "$card_dir" --url "$url"
}

