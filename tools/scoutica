cmd_preview() {
    local target_dir="${1:-.}"
    local force=false
    [ "${1:-}" = "--force" ] || [ "${2:-}" = "--force" ] && force=true
    [ "${1:-}" = "--force" ] && target_dir="${2:-.}"
    
    if [ ! -f "$target_dir/profile.json" ]; then
        error "No profile.json found in $target_dir. Run 'scoutica scan' first."
        exit 1
    fi
    
    # ── Smart caching: skip if card unchanged and URL still valid ──
    if [ "$force" = false ]; then
        local current_card_hash=$(_compute_card_hash "$target_dir")
        local stored_card_hash=$(_read_state "$target_dir" "preview.card_hash" 2>/dev/null || true)
        local stored_url=$(_read_state "$target_dir" "preview.url" 2>/dev/null || true)
        local stored_expires=$(_read_state "$target_dir" "preview.expires_at" 2>/dev/null || true)
        
        if [ -n "$stored_card_hash" ] && [ "$current_card_hash" = "$stored_card_hash" ] && [ -n "$stored_url" ] && [ -n "$stored_expires" ]; then
            # Check if URL is still valid (not expired)
            local now_epoch=$(date +%s)
            local expires_epoch=$(python3 -c "import sys;from datetime import datetime;print(int(datetime.strptime(sys.argv[1],'%Y-%m-%dT%H:%M:%SZ').timestamp()))" "$stored_expires" 2>/dev/null || echo "0")
            
            if [ "$now_epoch" -lt "$expires_epoch" ]; then
                local remaining_hrs=$(( (expires_epoch - now_epoch) / 3600 ))
                echo ""
                echo -e "${GREEN}╔═══════════════════════════════════════════════════════╗${NC}"
                echo -e "${GREEN}║${NC}                                                       ${GREEN}║${NC}"
                echo -e "${GREEN}║${NC}   🌍 ${BOLD}Your Skill Card is still live!${NC}                  ${GREEN}║${NC}"
