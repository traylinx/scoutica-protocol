# ─── VALIDATE Command ────────────────────────────────────────────────────────

cmd_validate() {
    local card_dir=""
    local schema_dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --schema-dir)
                if [ $# -lt 2 ] || [ -z "$2" ]; then
                    error "--schema-dir requires an absolute directory path."
                    return 1
                fi
                schema_dir="$2"
                shift 2
                ;;
            --schema-dir=*)
                schema_dir="${1#--schema-dir=}"
                shift
                ;;
            --*)
                error "Unknown validate option: $1"
                return 1
                ;;
            *)
                if [ -n "$card_dir" ]; then
                    error "Validate accepts only one card directory."
                    return 1
                fi
                card_dir="$1"
                shift
                ;;
        esac
    done

    if [ -n "$schema_dir" ]; then
        case "$schema_dir" in
            /*) : ;;
            *)
                error "--schema-dir must be an absolute directory path."
                return 1
                ;;
        esac
        if [ ! -d "$schema_dir" ]; then
            error "Schema directory not found: $schema_dir"
            return 1
        fi
    fi
    
    # Smart context resolution
    if [ -z "$card_dir" ]; then
        card_dir=$(_resolve_card_dir) || {
            header "Validate Skill Card"
            error "No Skill Card found."
            echo ""
            echo -e "  ${BOLD}Create your card first:${NC}"
            echo -e "  ${CYAN}scoutica scan <docs-folder>${NC}   Auto-generate from your CV (easiest)"
            echo ""
            exit 1
        }
    fi
    
    header "Validate Skill Card"
    
    # Pre-check: are there any card files here?
    if [ ! -f "$card_dir/profile.json" ] && [ ! -f "$card_dir/SKILL.md" ]; then
        error "No Skill Card found in $card_dir"
        echo ""
        echo -e "  ${BOLD}Create your card first:${NC}"
        echo -e "  ${CYAN}scoutica scan <docs-folder>${NC}   Auto-generate from your CV (easiest)"
        echo -e "  ${CYAN}scoutica init${NC}                  Interactive wizard"
        echo ""
        exit 1
    fi
    
    # Validate prerequisites without mutating the user's global Python environment.
    _require_validation_runtime || return 1
    local python_cmd="$VALIDATION_PYTHON"
    
    # Check for validation script in multiple locations
    local validator=""
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    
    if [ -f "$script_dir/validate_card.py" ]; then
        validator="$script_dir/validate_card.py"
    elif [ -f "$SCOUTICA_HOME/bin/validate_card.py" ]; then
        validator="$SCOUTICA_HOME/bin/validate_card.py"
    elif [ -f "$SCOUTICA_HOME/tools/validate_card.py" ]; then
        validator="$SCOUTICA_HOME/tools/validate_card.py"
    fi
    
    if [ -z "$validator" ]; then
        error "Validation script not found. Re-run the installer."
        exit 1
    fi
    
    # Run validation
    local validator_args=("$card_dir")
    if [ -n "$schema_dir" ]; then
        validator_args+=(--schema-dir "$schema_dir")
    fi
    "$python_cmd" "$validator" "${validator_args[@]}"
}

