cmd_publish() {
    local card_dir="${1:-}"
    
    # Smart context resolution
    if [ -z "$card_dir" ]; then
        card_dir=$(_resolve_card_dir) || {
            header "Publish to GitHub"
            error "No Skill Card found."
            echo -e "  ${DIM}Run 'scoutica scan <docs-folder>' first.${NC}"
            exit 1
        }
    fi
    
    header "Publish to GitHub"
    
    # Check if git is available
    if ! command -v git &>/dev/null; then
        error "Git is not installed on your system."
        echo ""
        echo -e "  ${BOLD}To publish your Scoutica Protocol card, you need a free GitHub account.${NC}"
        echo -e "  1. Create an account: ${CYAN}https://github.com/signup${NC}"
        echo -e "  2. Install Git:        ${CYAN}https://git-scm.com/downloads${NC}"
        echo -e "  3. After installing, run ${CYAN}scoutica publish${NC} again."
        echo ""
        exit 1
    fi
    
    # Check if already a git repo
    if [ -d "$card_dir/.git" ]; then
        (
            cd "$card_dir" || return 1
            if ! git remote get-url origin >/dev/null 2>&1; then
                error "No remote 'origin' configured."
                echo -e "  ${DIM}Run: git remote add origin https://github.com/YOU/YOUR-CARD.git${NC}" >&2
                return 1
            fi

            _git_require_canonical_index candidate "pre-existing" || return 1
            if ! _git_stage_canonical_paths candidate; then
                error "Failed to stage canonical Skill Card files."
                return 1
            fi
            _git_require_canonical_index candidate "final" || return 1

            local publish_branch
            publish_branch=$(git branch --show-current 2>/dev/null || true)
            if [ -z "$publish_branch" ]; then
                error "Cannot publish from a detached HEAD or unnamed branch."
                return 1
            fi
            
            # Preview changes to the user
            local changes
            changes=$(git diff --cached --name-status -- 2>/dev/null) || {
                error "Could not inspect staged Skill Card changes."
                return 1
            }
            
            if [ -z "$changes" ]; then
                if ! git push origin "$publish_branch" >/dev/null 2>&1; then
                    error "Push failed. The remote may not contain the local Skill Card commit."
                    return 1
                fi
                echo -e "  ${GREEN}✅${NC} Your Skill Card is up to date and synchronized!"
                local origin_url
                origin_url=$(git remote get-url origin) || return 1
                local clean_url
                clean_url=$(echo "$origin_url" | sed 's/\.git$//')
                echo -e "  ${DIM}Live at:${NC} $clean_url"
                local abs_card_dir
                abs_card_dir=$(pwd)
                _register_card "$abs_card_dir" "publish" '{"github_url": "'"$clean_url"'"}'
                return $?
            fi
            
            echo -e "  ${BOLD}The following changes will be published:${NC}"
            echo "$changes" | while read -r line; do
                echo -e "    ${CYAN}$line${NC}"
            done
            echo ""
            
            local msg="Update Scoutica Protocol Skill Card — $(date +%Y-%m-%d)"
            if ! git commit -m "$msg" >/dev/null 2>&1; then
                error "Commit failed. No publish was recorded."
                return 1
            fi
            
            echo -e "  ${DIM}Pushing to GitHub...${NC}"
            if ! git push origin "$publish_branch" >/dev/null 2>&1; then
                error "Push failed. Check your remote configuration or permissions."
                return 1
            fi

            echo -e "  ${GREEN}✅ Successfully published to GitHub!${NC}"
