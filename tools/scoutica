_slugify_name() {
    local name="$1"
    echo "$name" | tr '[:upper:]' '[:lower:]' | \
        sed 's/[^a-z0-9 ]//g' | \
        sed 's/  */ /g' | \
        sed 's/ /-/g' | \
        sed 's/--*/-/g' | \
        sed 's/^-//;s/-$//'
}

# ─── Global Registry ─────────────────────────────────────────────────────────

_register_card() {
    local card_dir="$1" event="$2"
    shift 2
    local extra_json="${1:-{}}"
    
    mkdir -p "$SCOUTICA_HOME"
    
    # Read name and title from profile.json if available
    local name="" title=""
    if [ -f "$card_dir/profile.json" ] && command -v python3 &>/dev/null; then
        name=$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]+'/profile.json'));print(d.get('name',''))" "$card_dir" 2>/dev/null || echo "")
        title=$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]+'/profile.json'));print(d.get('title',''))" "$card_dir" 2>/dev/null || echo "")
    fi
    
    python3 << 'REGSCRIPT' - "$REGISTRY_FILE" "$card_dir" "$event" "$name" "$title" "$extra_json"
import json, os, sys
from datetime import datetime, timezone

registry_file = sys.argv[1]
card_dir = os.path.abspath(sys.argv[2])
event = sys.argv[3]
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
name = sys.argv[4]
title = sys.argv[5]

try:
    extra = json.loads(sys.argv[6])
except:
    extra = {}

# Load existing registry
try:
    with open(registry_file) as f:
        registry = json.load(f)
except:
    registry = {"schema_version": "0.1.0", "cards": {}}

if "cards" not in registry:
    registry["cards"] = {}

# Get or create card entry
card = registry["cards"].get(card_dir, {
    "name": name,
    "title": title,
    "card_dir": card_dir,
    "source_dir": None,
    "github_url": None,
    "preview_url": None,
    "created_at": now,
    "last_scanned": None,
    "last_published": None,
    "last_previewed": None,
    "provider": None,
    "scan_count": 0,
    "exists": True,
    "history": []
})

# Update fields
if name: card["name"] = name
if title: card["title"] = title
card["exists"] = os.path.isdir(card_dir)

history_entry = {"event": event, "at": now}

if event == "scan" or event == "rescan":
    card["last_scanned"] = now
    card["scan_count"] = card.get("scan_count", 0) + 1
    if extra.get("provider"): card["provider"] = extra["provider"]
    if extra.get("source_dir"): card["source_dir"] = extra["source_dir"]
    history_entry["provider"] = extra.get("provider", "unknown")
elif event == "publish":
    card["last_published"] = now
    if extra.get("github_url"): card["github_url"] = extra["github_url"]
    history_entry["github_url"] = extra.get("github_url", "")
elif event == "preview":
    card["last_previewed"] = now
    if extra.get("preview_url"): card["preview_url"] = extra["preview_url"]
    history_entry["preview_url"] = extra.get("preview_url", "")

card["history"].append(history_entry)
# Keep last 50 history entries
card["history"] = card["history"][-50:]

registry["cards"][card_dir] = card

with open(registry_file, "w") as f:
    json.dump(registry, f, indent=2)
REGSCRIPT
}

_get_last_card() {
    if [ ! -f "$REGISTRY_FILE" ] || ! command -v python3 &>/dev/null; then
        echo ""
        return
    fi
    python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        reg = json.load(f)
    cards = reg.get('cards', {})
    if not cards:
        print('')
    else:
        latest = max(cards.values(), key=lambda c: c.get('last_scanned') or c.get('created_at') or '')
        print(latest.get('card_dir', ''))
except:
    print('')
" "$REGISTRY_FILE" 2>/dev/null
}

_resolve_card_dir() {
    local explicit="${1:-}"
    
    # 1. Explicit argument passed
    if [ -n "$explicit" ] && [ -f "$explicit/profile.json" ]; then
        echo "$explicit"
        return 0
    fi
    
    # 2. CWD has a card
    if [ -f "./profile.json" ]; then
        echo "."
        return 0
    fi
    
    # 3. CWD is inside a card subfolder (parent has profile.json)
    if [ -f "../profile.json" ]; then
        echo ".."
        return 0
    fi
    
    # 4. Check global registry for last known card
    local last_card=$(_get_last_card)
    if [ -n "$last_card" ] && [ -d "$last_card" ] && [ -f "$last_card/profile.json" ]; then
        echo -e "  ${DIM}Using last known card: $last_card${NC}" >&2
        echo "$last_card"
        return 0
    fi
    
    # 5. Registry knows a card but folder is gone
    if [ -n "$last_card" ] && [ ! -d "$last_card" ]; then
        echo -e "  ${YELLOW}⚠️  Last known card folder was deleted: $last_card${NC}" >&2
        # Check if there's a GitHub URL stored
        local gh_url
        gh_url=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        reg = json.load(f)
    card = reg['cards'].get(sys.argv[2], {})
    print(card.get('github_url', '') or '')
except: print('')
" "$REGISTRY_FILE" "$last_card" 2>/dev/null)
        if [ -n "$gh_url" ]; then
            echo -e "  ${DIM}Last published to: $gh_url${NC}" >&2
        fi
        echo -e "  ${DIM}Run 'scoutica scan' to regenerate your card.${NC}" >&2
        return 1
    fi
    
    # 6. Nothing found
    return 1
}

# ─── SCAN Command ─────────────────────────────────────────────────────────────

# Phase 3 scan runtime. This subshell owns exactly one private directory and
# keeps its EXIT/signal handlers in scope until every child has been reaped.
_cmd_scan_runtime() (
    local source_dir="" output_dir="" provider="" explicit_output=false
    local force=false allow_remote=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --output|-o)
                [ "$#" -ge 2 ] || { error "--output requires a directory"; return 1; }
                output_dir="$2"; explicit_output=true; shift 2 ;;
            --with|-w)
                [ "$#" -ge 2 ] || { error "--with requires a provider"; return 1; }
                provider="$2"; shift 2 ;;
            --force|-f) force=true; shift ;;
            --allow-remote-provider) allow_remote=true; shift ;;
            --clipboard|-c) provider="clipboard"; shift ;;
            --help|-h)
                cat >&2 <<'SCAN_HELP'
  Usage: scoutica scan <docs-folder> [options]

  Extraction happens locally. The complete generated prompt and document text
  are then supplied to the selected provider.

  Options:
    --output, -o <dir>          Exact Skill Card output directory
    --with, -w <provider>       gemini, claude, codex, opencode, ollama, ail
    --allow-remote-provider     Consent to this remote-capable invocation
    --clipboard, -c             Copy full prompt; Scoutica makes no network call
    --force, -f                 Ignore unchanged card-owned state

  Limits: 2 MiB extracted text per file, 4 MiB aggregate, 8 MiB response,
  and 300 seconds provider wall time.
SCAN_HELP
                return 0 ;;
            -*) error "Unknown scan option: $1"; return 1 ;;
            *)
                if [ -n "$source_dir" ]; then
                    error "Unexpected scan argument: $1"
                    return 1
                fi
                source_dir="$1"; shift ;;
        esac
    done

    if [ -z "$source_dir" ]; then
        error "Usage: scoutica scan <docs-folder> [--output <dir>] [--with <provider>]"
        return 1
    fi
    [ -d "$source_dir" ] || { error "Directory not found: $source_dir"; return 1; }
    _require_validation_runtime || return 1

    local runtime_helper
    runtime_helper=$(_scan_runtime_helper) || {
        error "Scan runtime helper not found. Re-run the installer."
        return 1
    }
    source_dir=$("$VALIDATION_PYTHON" -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$source_dir") || return 1

    # Fixed provider registry: uncharacterized argv-only adapters never run.
    if [ -z "$provider" ] || [ "$provider" = "default" ]; then
        if command -v gemini >/dev/null 2>&1; then provider=gemini
        elif command -v claude >/dev/null 2>&1; then provider=claude
        elif command -v codex >/dev/null 2>&1; then provider=codex
        elif command -v opencode >/dev/null 2>&1; then provider=opencode
        elif command -v ollama >/dev/null 2>&1; then provider=ollama
        elif curl -sf --connect-timeout 1 --max-time 2 http://127.0.0.1:18080/health >/dev/null 2>&1; then provider=ail
        else provider=clipboard
        fi
    fi

    local provider_record provider_status provider_scope provider_destination provider_reason
    provider_record=$("$VALIDATION_PYTHON" "$runtime_helper" provider-info "$provider") || return 1
    IFS=$'\t' read -r provider_status provider_scope provider_destination provider_reason <<< "$provider_record"
    if [ "$provider_status" != "enabled" ]; then
        error "Provider '$provider' is disabled: ${provider_reason:-no safe prompt transport}"
        echo -e "  ${DIM}Use gemini, claude, codex, opencode, ollama, ail, or --clipboard.${NC}" >&2
        return 1
    fi
    case "$provider" in
        ail|clipboard) : ;;
        *) command -v "$provider" >/dev/null 2>&1 || {
            error "$provider is not installed on your system."
            return 1
        } ;;
    esac

    if [ "$provider_scope" = "remote" ]; then
        warn "Remote-capable provider selected: $provider"
        echo -e "  ${BOLD}Destination:${NC} $provider_destination" >&2
        echo -e "  ${YELLOW}The full prompt and extracted document text will be sent to that provider.${NC}" >&2
        if [ "$allow_remote" != true ]; then
            if [ -t 0 ]; then
                local consent=""
                echo -ne "  Continue for this invocation? [y/N]: " >&2
                IFS= read -r consent || consent=""
                case "$consent" in y|Y|yes|YES|Yes) : ;; *) error "Remote provider consent declined."; return 1 ;; esac
            else
                error "Noninteractive remote-capable scan requires --allow-remote-provider."
                return 1
            fi
        fi
    elif [ "$provider_scope" = "local" ]; then
        echo -e "  ${DIM}Provider destination: $provider_destination. Extracted text stays on this endpoint.${NC}" >&2
    else
        warn "Clipboard mode copies the full prompt and all extracted document text into the system clipboard."
        echo -e "  ${DIM}Scoutica performs no network call; onward transfer depends on where you paste it.${NC}" >&2
    fi

    # Explicit output wins. Otherwise only a unique source-dir registry mapping
    # can select prior card state; legacy cwd state is ignored.
    local mapping_status="" mapping_record=""
    if [ "$explicit_output" = true ]; then
        while [ "$output_dir" != "/" ] && [ "${output_dir%/}" != "$output_dir" ]; do
            output_dir="${output_dir%/}"
        done
        output_dir=$("$VALIDATION_PYTHON" "$runtime_helper" output-path --path "$output_dir") || {
            error "Refusing unsafe output directory."
            return 1
        }
    else
        mapping_record=$("$VALIDATION_PYTHON" "$runtime_helper" registry-card \
            --registry "$REGISTRY_FILE" --source "$source_dir" 2>/dev/null || true)
        if [ -n "$mapping_record" ]; then
            IFS=$'\t' read -r output_dir mapping_status <<< "$mapping_record"
        fi
    fi

    local current_hash stored_hash="" stored_source=""
    current_hash=$("$VALIDATION_PYTHON" "$runtime_helper" source-hash --source "$source_dir") || return 1
    if [ -n "$output_dir" ] && [ -d "$output_dir" ]; then
        stored_hash=$(_read_state "$output_dir" "card.source_hash" 2>/dev/null || true)
        stored_source=$(_read_state "$output_dir" "card.source_path" 2>/dev/null || true)
    fi
    if [ "$force" = false ] && [ -n "$output_dir" ] \
        && { [ "$explicit_output" = true ] || [ "$mapping_status" = valid ]; } \
        && [ "$stored_source" = "$source_dir" ] && [ "$stored_hash" = "$current_hash" ]; then
        local complete=true state_file
        for state_file in profile.json rules.yaml evidence.json SKILL.md; do
            [ -f "$output_dir/$state_file" ] || complete=false
        done
        if [ "$complete" = true ]; then
            success "Card is up to date (source documents unchanged)"
            echo -e "  ${DIM}Card-owned state: $output_dir/.scoutica/state.json${NC}" >&2
            return 0
        fi
    fi

    local _SCAN_RUN_DIR _SCAN_CHILD_PID=""
    _SCAN_RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/scoutica-scan.XXXXXX") || {
        error "Could not create private scan runtime directory."
        return 1
    }
    chmod 700 "$_SCAN_RUN_DIR" || return 1
    _scan_runtime_cleanup() {
        local cleanup_rc="$1"
        trap - EXIT INT TERM
        if [ -n "${_SCAN_CHILD_PID:-}" ] && kill -0 "$_SCAN_CHILD_PID" 2>/dev/null; then
            kill -TERM "$_SCAN_CHILD_PID" 2>/dev/null || true
            wait "$_SCAN_CHILD_PID" 2>/dev/null || true
        fi
        rm -rf "$_SCAN_RUN_DIR" 2>/dev/null || true
        exit "$cleanup_rc"
    }
    _scan_runtime_signal() {
        local scan_signal="$1" scan_signal_rc=143
        [ "$scan_signal" = INT ] && scan_signal_rc=130
        if [ -n "${_SCAN_CHILD_PID:-}" ] && kill -0 "$_SCAN_CHILD_PID" 2>/dev/null; then
            kill -s "$scan_signal" "$_SCAN_CHILD_PID" 2>/dev/null || true
            wait "$_SCAN_CHILD_PID" 2>/dev/null || true
            _SCAN_CHILD_PID=""
        fi
        exit "$scan_signal_rc"
    }
    trap '_scan_runtime_cleanup $?' EXIT
    trap '_scan_runtime_signal INT' INT
    trap '_scan_runtime_signal TERM' TERM

    _scan_log_init
    _scan_log "INIT" "source_dir=$source_dir, provider=$provider, output=${output_dir:-registry-miss}"
    header "AI-Powered Card Generation"
    echo -e "  ${BLUE}→${NC} Extracting bounded text from ${BOLD}$source_dir${NC}..."

    local prompt_file="$_SCAN_RUN_DIR/prompt.txt"
    local response_file="$_SCAN_RUN_DIR/response.txt"
    local provider_log="$_SCAN_RUN_DIR/provider.log"
    local content_file="$_SCAN_RUN_DIR/content.txt"
    local snapshot_dir="$_SCAN_RUN_DIR/source-snapshot"
    local stage_dir="$_SCAN_RUN_DIR/stage"
    local scan_prompt_file file snapshot_file basename ext content_size aggregate_size=0 file_count=0 input_size
    mkdir -p "$snapshot_dir"
    chmod 700 "$snapshot_dir"
    scan_prompt_file="$SCOUTICA_HOME/bin/SCAN_PROMPT.md"
    if [ ! -f "$scan_prompt_file" ]; then
        scan_prompt_file="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/SCAN_PROMPT.md"
    fi
    if [ -f "$scan_prompt_file" ]; then
        cat "$scan_prompt_file" > "$prompt_file"
    else
        printf '%s\n' "Generate a Scoutica card. Return one JSON object with profile, rules, evidence, and skill_md." > "$prompt_file"
    fi
    printf '\n## Candidate Documents\n' >> "$prompt_file"

    for file in "$source_dir"/*; do
        [ -f "$file" ] || continue
        [ -L "$file" ] && { error "Refusing symlinked source document: $file"; return 1; }
        basename=$(basename "$file")
        case "$basename" in
            profile.json|rules.yaml|evidence.json|SKILL.md|README.md|scoutica_prompt.txt|scoutica.json) continue ;;
        esac
        ext=${basename##*.}
        ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
        case "$ext" in md|txt|json|yaml|yml|csv|html|htm|pdf|docx) : ;; *) continue ;; esac
        input_size=$(wc -c < "$file" | tr -d '[:space:]')
        if [ "${input_size:-0}" -gt 2097152 ]; then
            error "Source file exceeds the 2 MiB limit: $basename"
            return 1
        fi
        snapshot_file="$snapshot_dir/$basename"
        cat "$file" > "$snapshot_file" || {
            error "Could not snapshot source document: $basename"
            return 1
        }
        input_size=$(wc -c < "$snapshot_file" | tr -d '[:space:]')
        if [ "${input_size:-0}" -gt 2097152 ]; then
            error "Source file changed beyond the 2 MiB limit while reading: $basename"
            return 1
        fi
        : > "$content_file"
        case "$ext" in
            md|txt|json|yaml|yml|csv|html|htm) cat "$snapshot_file" > "$content_file" ;;
            pdf)
                if command -v pdftotext >/dev/null 2>&1; then
                    pdftotext "$snapshot_file" "$content_file" 2>/dev/null || true
                elif command -v textutil >/dev/null 2>&1; then
                    textutil -convert txt -stdout "$snapshot_file" > "$content_file" 2>/dev/null || true
                else
                    "$VALIDATION_PYTHON" - "$snapshot_file" > "$content_file" 2>/dev/null <<'PDF_EXTRACT' || true
import sys
try:
    import PyPDF2
    for page in PyPDF2.PdfReader(sys.argv[1]).pages:
        print(page.extract_text() or "")
except Exception:
    pass
PDF_EXTRACT
                fi ;;
            docx)
                if command -v textutil >/dev/null 2>&1; then
                    textutil -convert txt -stdout "$snapshot_file" > "$content_file" 2>/dev/null || true
                else
                    "$VALIDATION_PYTHON" - "$snapshot_file" > "$content_file" 2>/dev/null <<'DOCX_EXTRACT' || true
import sys
try:
    import docx
    for paragraph in docx.Document(sys.argv[1]).paragraphs:
        print(paragraph.text)
except Exception:
    pass
DOCX_EXTRACT
                fi ;;
        esac
        content_size=$(wc -c < "$content_file" | tr -d '[:space:]')
        [ "${content_size:-0}" -gt 0 ] || continue
        if [ "$content_size" -gt 2097152 ]; then
            error "Extracted text exceeds the 2 MiB per-file limit: $basename"
            return 1
        fi
        aggregate_size=$((aggregate_size + content_size))
        if [ "$aggregate_size" -gt 4194304 ]; then
            error "Extracted text exceeds the 4 MiB aggregate limit."
            return 1
        fi
        printf '\n--- FILE: %s ---\n' "$basename" >> "$prompt_file"
        cat "$content_file" >> "$prompt_file"
        printf '\n' >> "$prompt_file"
        file_count=$((file_count + 1))
        echo -e "    ${GREEN}📄${NC} $basename ${DIM}($content_size bytes)${NC}"
    done
    [ "$file_count" -gt 0 ] || { error "No readable documents found in $source_dir"; return 1; }
    local snapshot_hash post_extract_hash
    snapshot_hash=$("$VALIDATION_PYTHON" "$runtime_helper" source-hash --source "$snapshot_dir") || return 1
    post_extract_hash=$("$VALIDATION_PYTHON" "$runtime_helper" source-hash --source "$source_dir") || return 1
    if [ "$snapshot_hash" != "$post_extract_hash" ]; then
        error "Source documents changed during extraction; re-run scan."
        return 1
    fi
    echo -e "  ${GREEN}✅${NC} Prepared $file_count documents (${aggregate_size} extracted bytes)"

    if [ "$provider" = clipboard ]; then
        if command -v pbcopy >/dev/null 2>&1; then
            pbcopy < "$prompt_file"
            success "Full scan prompt copied to the system clipboard."
        elif command -v xclip >/dev/null 2>&1; then
            xclip -selection clipboard < "$prompt_file"
            success "Full scan prompt copied to the system clipboard."
        else
            [ -n "$output_dir" ] || output_dir="$source_dir/scoutica-card"
            [ -L "$output_dir" ] && { error "Refusing symlinked output directory: $output_dir"; return 1; }
            mkdir -p "$output_dir"
            cp "$prompt_file" "$output_dir/scoutica_prompt.txt"
            chmod 600 "$output_dir/scoutica_prompt.txt" 2>/dev/null || true
            success "Clipboard utility unavailable; prompt saved to $output_dir/scoutica_prompt.txt"
        fi
        return 0
    fi

    echo -e "  ${BLUE}→${NC} Invoking ${BOLD}$provider${NC}; prompt is supplied through stdin, never argv."
    "$VALIDATION_PYTHON" "$runtime_helper" run-provider "$provider" \
        --prompt-file "$prompt_file" --response-file "$response_file" --log-file "$provider_log" &
    _SCAN_CHILD_PID=$!
    local provider_rc=0
    wait "$_SCAN_CHILD_PID" || provider_rc=$?
    _SCAN_CHILD_PID=""
    if [ "$provider_rc" -ne 0 ]; then
        error "Provider '$provider' failed (exit $provider_rc)."
        [ -s "$provider_log" ] && sed 's/^/    /' "$provider_log" >&2
        return 1
    fi
    [ -s "$response_file" ] || { error "Provider '$provider' returned an empty response."; return 1; }

    mkdir -p "$stage_dir/rules"
    chmod 700 "$stage_dir" "$stage_dir/rules"
    if ! "$VALIDATION_PYTHON" "$runtime_helper" parse-response \
        --response-file "$response_file" --stage-dir "$stage_dir"; then
        error "Provider response was not a complete Scoutica card."
        return 1
    fi
    local template_root="$TEMPLATES_DIR" rule_name
    if [ ! -d "$template_root/rules" ]; then
        template_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/protocol/templates"
    fi
    for rule_name in evaluate-fit.md negotiate-terms.md verify-evidence.md request-interview.md; do
        [ -f "$template_root/rules/$rule_name" ] && cp "$template_root/rules/$rule_name" "$stage_dir/rules/$rule_name"
    done
    [ -f "$template_root/card.gitignore" ] && cp "$template_root/card.gitignore" "$stage_dir/.gitignore"

    if ! cmd_validate "$stage_dir"; then
        error "Generated card failed strict validation; prior card remains active."
        return 1
    fi

    local pre_promote_hash
    pre_promote_hash=$("$VALIDATION_PYTHON" "$runtime_helper" source-hash --source "$source_dir") || return 1
    if [ "$pre_promote_hash" != "$snapshot_hash" ]; then
        error "Source documents changed while the provider was running; prior card remains active."
        return 1
    fi

    if [ -z "$output_dir" ]; then
        local card_name slug
        card_name=$("$VALIDATION_PYTHON" -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("name", ""))' "$stage_dir/profile.json") || card_name=""
        slug=$(_slugify_name "$card_name")
        [ -n "$slug" ] || slug=scoutica
        output_dir="$source_dir/${slug}-card"
    fi
    [ -L "$output_dir" ] && { error "Refusing symlinked output directory: $output_dir"; return 1; }

    "$VALIDATION_PYTHON" "$runtime_helper" promote \
        --stage-dir "$stage_dir" --card-dir "$output_dir" --source-dir "$source_dir" \
        --source-hash "$snapshot_hash" --provider "$provider" --registry "$REGISTRY_FILE" &
    _SCAN_CHILD_PID=$!
    local promote_rc=0
    wait "$_SCAN_CHILD_PID" || promote_rc=$?
    _SCAN_CHILD_PID=""
    if [ "$promote_rc" -ne 0 ]; then
        error "Validated card promotion failed; no card was reported ready."
        return "$promote_rc"
    fi
    output_dir=$("$VALIDATION_PYTHON" -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$output_dir") || return 1

    _scan_log "WRITE" "validated card promoted to $output_dir"
    echo ""
    success "Your validated Scoutica Protocol Skill Card is ready: $output_dir"
    echo -e "  ${DIM}Private state: $output_dir/.scoutica/state.json${NC}"
    return 0
)

# Keep the public command in the top-level shell so signals sent to the CLI PID
# are forwarded to the lifecycle-owning scan subshell. The wrapper clears its
# handlers before every return; no function-local EXIT trap escapes scope.
cmd_scan() {
    local scan_runtime_pid scan_runtime_rc=0 scan_direct_child
    _cmd_scan_runtime "$@" <&0 &
    scan_runtime_pid=$!
    # While the runtime is waiting, its direct child is the Python lifecycle
    # helper. Signal that helper first so it can forward to and reap the actual
    # provider; the runtime then observes failure and removes its private dir.
    trap 'for scan_direct_child in $(ps -eo pid=,ppid= 2>/dev/null | awk -v parent="$scan_runtime_pid" '\''$2 == parent {print $1}'\''); do kill -INT "$scan_direct_child" 2>/dev/null || true; done; wait "$scan_runtime_pid" 2>/dev/null || true; trap - INT TERM; return 130' INT
    trap 'for scan_direct_child in $(ps -eo pid=,ppid= 2>/dev/null | awk -v parent="$scan_runtime_pid" '\''$2 == parent {print $1}'\''); do kill -TERM "$scan_direct_child" 2>/dev/null || true; done; wait "$scan_runtime_pid" 2>/dev/null || true; trap - INT TERM; return 143' TERM
    wait "$scan_runtime_pid" || scan_runtime_rc=$?
    trap - INT TERM
    return "$scan_runtime_rc"
}

cmd_resolve() {
    local url="${1:-}"
    local save_dir="${2:-}"
    
    if [ -z "$url" ] || [ "$url" = "--help" ] || [ "$url" = "-h" ]; then
        echo -e "  ${BOLD}Usage:${NC} scoutica resolve <card-url> [save-to-dir]" >&2
        echo "" >&2
        echo -e "  ${DIM}Fetch and display a Scoutica Protocol Skill Card from any URL.${NC}" >&2
        echo "" >&2
        echo -e "  ${BOLD}Supported URL formats:${NC}" >&2
        echo -e "    ${CYAN}https://github.com/user/repo${NC}" >&2
        echo -e "    ${CYAN}https://raw.githubusercontent.com/user/repo/main/${NC}" >&2
        echo -e "    ${CYAN}https://example.com/path/to/card/${NC}" >&2
        echo "" >&2
        echo -e "  ${BOLD}Examples:${NC}" >&2
        echo -e "    scoutica resolve https://github.com/user/my-card" >&2
        echo -e "    scoutica resolve https://github.com/user/my-card ./local-copy/" >&2
        return 0
    fi
    
    # URL validation + IP pinning happens on the FINAL normalized base_url below, so the check
    # covers the exact host we fetch and pins curl to that IP (defeats DNS rebinding).
    if ! printf '%s' "$url" | grep -qE '^https://'; then
        error "Only HTTPS URLs are supported (got: $url)"
        exit 1
    fi
    
    # ── Normalize URL to raw base ──
    local base_url=""
    
    if echo "$url" | grep -q "raw.githubusercontent.com"; then
        # Already a raw URL — strip trailing file if present
        base_url=$(echo "$url" | sed 's|/profile\.json$||; s|/rules\.yaml$||; s|/evidence\.json$||; s|/SKILL\.md$||; s|/$||')
    elif echo "$url" | grep -q "github.com"; then
        # Convert github.com URL → raw.githubusercontent.com
        local gh_path
        gh_path=$(echo "$url" | sed 's|https://github.com/||; s|\.git$||; s|/$||')
        local gh_user=$(echo "$gh_path" | cut -d'/' -f1)
        local gh_repo=$(echo "$gh_path" | cut -d'/' -f2)
        local gh_branch="main"
        # Check if URL has a branch/path beyond user/repo
        local extra=$(echo "$gh_path" | cut -d'/' -f3- 2>/dev/null)
        if echo "$extra" | grep -q "^tree/"; then
            gh_branch=$(echo "$extra" | sed 's|^tree/||; s|/.*||')
        fi
        base_url="https://raw.githubusercontent.com/$gh_user/$gh_repo/$gh_branch"
    else
        # Assume direct URL
        base_url=$(echo "$url" | sed 's|/$||')
    fi
    
    # ── SSRF: validate the FINAL fetch target, then pin curl to the validated host:port:ip so the
    # connection cannot be rebound between check and fetch — covers IPv4+IPv6 and non-443 ports
    # (M6/F-HIGH-SSRF-001). ---
    local pin_spec fetch_host fetch_port pin_ip resolve_args=""
    pin_spec=$(_validate_url "$base_url") || exit 1
    read -r fetch_host fetch_port pin_ip <<<"$pin_spec"
    case "$pin_ip" in
        "")  ;;
        *:*) resolve_args="--resolve $fetch_host:$fetch_port:[$pin_ip]" ;;  # IPv6 must be bracketed
        *)   resolve_args="--resolve $fetch_host:$fetch_port:$pin_ip" ;;
    esac

    header "Resolving Skill Card"
    echo -e "  ${BLUE}→${NC} Fetching from ${DIM}$base_url${NC}"
    echo ""
    
    # ── Try scoutica.json first ──
    local discovery
    discovery=$(curl -sf --connect-timeout 10 --max-time 30 --max-filesize 2097152 $resolve_args "$base_url/scoutica.json" 2>/dev/null)
    if [ -n "$discovery" ]; then
        echo -e "  ${GREEN}✅${NC} Found scoutica.json (discovery file)"
        local card_url
        card_url=$(echo "$discovery" | python3 -c "import sys,json; print(json.load(sys.stdin).get('card_url',''))" 2>/dev/null)
        if [ -n "$card_url" ] && [ "$card_url" != "$base_url" ]; then
            # A discovery file is attacker-influenced — re-run the SAME guard so it cannot
            # redirect the fetch to an internal host (F-HIGH-SSRF-001).
            base_url=$(echo "$card_url" | sed 's|/$||')
            pin_spec=$(_validate_url "$base_url") || { error "Discovered card_url failed validation; refusing redirect"; exit 1; }
            read -r fetch_host fetch_port pin_ip <<<"$pin_spec"
            resolve_args=""
            case "$pin_ip" in
                "")  ;;
                *:*) resolve_args="--resolve $fetch_host:$fetch_port:[$pin_ip]" ;;  # IPv6 bracketed
                *)   resolve_args="--resolve $fetch_host:$fetch_port:$pin_ip" ;;
            esac
            echo -e "  ${DIM}→ Card URL: $base_url${NC}"
        fi
    fi
    
    # ── Fetch card files ──
    local profile="" rules="" evidence="" skill_md=""
    local found=0
    
    profile=$(curl -sf --connect-timeout 10 --max-time 30 --max-filesize 2097152 $resolve_args "$base_url/profile.json" 2>/dev/null)
    if [ -n "$profile" ]; then
        echo -e "  ${GREEN}📄${NC} profile.json"
        found=$((found + 1))
    else
        echo -e "  ${RED}✗${NC} profile.json ${DIM}(not found)${NC}"
    fi
    
    rules=$(curl -sf --connect-timeout 10 --max-time 30 --max-filesize 2097152 $resolve_args "$base_url/rules.yaml" 2>/dev/null)
    if [ -n "$rules" ]; then
        echo -e "  ${GREEN}📄${NC} rules.yaml"
        found=$((found + 1))
    else
        echo -e "  ${RED}✗${NC} rules.yaml ${DIM}(not found)${NC}"
    fi
    
    evidence=$(curl -sf --connect-timeout 10 --max-time 30 --max-filesize 2097152 $resolve_args "$base_url/evidence.json" 2>/dev/null)
    if [ -n "$evidence" ]; then
        echo -e "  ${GREEN}📄${NC} evidence.json"
        found=$((found + 1))
    else
        echo -e "  ${RED}✗${NC} evidence.json ${DIM}(not found)${NC}"
    fi
    
    skill_md=$(curl -sf --connect-timeout 10 --max-time 30 --max-filesize 2097152 $resolve_args "$base_url/SKILL.md" 2>/dev/null)
    if [ -n "$skill_md" ]; then
        echo -e "  ${GREEN}📄${NC} SKILL.md"
        found=$((found + 1))
    else
        echo -e "  ${RED}✗${NC} SKILL.md ${DIM}(not found)${NC}"
    fi
    
    echo ""
    
    if [ "$found" -eq 0 ]; then
        error "No Scoutica Protocol card files found at $base_url"
        echo -e "  ${DIM}Make sure the URL points to a repo with profile.json at the root.${NC}" >&2
        exit 1
    fi
    
    echo -e "  ${GREEN}✅${NC} Found ${BOLD}$found/4${NC} card files"
    echo ""
    
    # ── Display card summary ──
    if [ -n "$profile" ]; then
        echo -e "${CYAN}╔═══════════════════════════════════════════════════════╗${NC}"
        
        local name title seniority years domains
        name=$(echo "$profile" | python3 -c "import sys,json; print(json.load(sys.stdin).get('name','Unknown'))" 2>/dev/null)
        title=$(echo "$profile" | python3 -c "import sys,json; print(json.load(sys.stdin).get('title',''))" 2>/dev/null)
        seniority=$(echo "$profile" | python3 -c "import sys,json; print(json.load(sys.stdin).get('seniority',''))" 2>/dev/null)
        years=$(echo "$profile" | python3 -c "import sys,json; print(json.load(sys.stdin).get('years_experience',''))" 2>/dev/null)
        domains=$(echo "$profile" | python3 -c "import sys,json; p=json.load(sys.stdin); print(', '.join(p.get('primary_domains', p.get('domains',[]))))" 2>/dev/null)
        
        echo -e "${CYAN}║${NC}  ${BOLD}$name${NC}"
        [ -n "$title" ] && echo -e "${CYAN}║${NC}  $title"
        [ -n "$seniority" ] && echo -e "${CYAN}║${NC}  ${DIM}Seniority:${NC} $seniority  ${DIM}|  Experience:${NC} ${years} years"
        [ -n "$domains" ] && echo -e "${CYAN}║${NC}  ${DIM}Domains:${NC} $domains"
        echo -e "${CYAN}╚═══════════════════════════════════════════════════════╝${NC}"
        echo ""
        
        # Skills summary
        local skills_summary
        skills_summary=$(echo "$profile" | python3 -c "
import sys, json
p = json.load(sys.stdin)
def _line(label, key):
    v = p.get(key, [])
    if isinstance(v, list) and v:
        return '  ' + label + ': ' + ', '.join(str(x) for x in v)
    return None
for line in (_line('Skills', 'skills'), _line('Tools', 'tools_and_platforms'), _line('Specializations', 'specializations')):
    if line:
        print(line)
" 2>/dev/null)
        
        if [ -n "$skills_summary" ]; then
            echo -e "  ${BOLD}Skills:${NC}"
            echo "$skills_summary"
            echo ""
        fi
    fi
    
    # ── Show rules summary ──
    if [ -n "$rules" ]; then
        local rules_summary
        rules_summary=$(echo "$rules" | python3 -c "
import sys, yaml
try:
    r = yaml.safe_load(sys.stdin) or {}
    comp = r.get('engagement', {}).get('compensation', {}).get('minimum_base_eur')
    if comp:
        if isinstance(comp, dict):
            comp = ', '.join(str(k) + ': ' + str(v) for k, v in comp.items())
        print('  Minimum salary: ' + str(comp) + ' EUR')
    if r.get('remote', {}).get('policy'):
        print('  Remote policy: ' + str(r['remote']['policy']))
    if r.get('engagement', {}).get('allowed_types'):
        print('  Engagement: ' + ', '.join(r['engagement']['allowed_types']))
    blocked = r.get('filters', {}).get('blocked_industries', [])
    if blocked:
        print('  Blocked industries: ' + ', '.join(blocked))
except Exception:
    pass
" 2>/dev/null)
        
        if [ -n "$rules_summary" ]; then
            echo -e "  ${BOLD}Rules of Engagement:${NC}"
            echo "$rules_summary"
            echo ""
        fi
    fi
    
    # ── Show evidence count ──
    if [ -n "$evidence" ]; then
        local ev_count
        ev_count=$(echo "$evidence" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('items',[])))" 2>/dev/null)
        echo -e "  ${BOLD}Evidence:${NC} $ev_count public items"
        echo ""
    fi
    
    # ── Save to local directory if requested ──
    if [ -n "$save_dir" ]; then
        # ── Symlink protection ──
        for f in profile.json rules.yaml evidence.json SKILL.md scoutica.json; do
            if [ -L "$save_dir/$f" ]; then
                error "Refusing to overwrite symlink: $save_dir/$f"
                exit 1
            fi
        done
        mkdir -p "$save_dir"
        # F-MED-FETCH-002: only persist remote JSON that actually parses (defends against a
        # hostile card writing garbage). rules.yaml / SKILL.md are text, already size-capped by curl.
        _json_ok() { printf '%s' "$1" | python3 -c 'import sys,json; json.load(sys.stdin)' 2>/dev/null; }
        [ -n "$profile" ] && { _json_ok "$profile" && echo "$profile" > "$save_dir/profile.json" || warn "Skipping profile.json: response was not valid JSON"; }
        [ -n "$rules" ] && echo "$rules" > "$save_dir/rules.yaml"
        [ -n "$evidence" ] && { _json_ok "$evidence" && echo "$evidence" > "$save_dir/evidence.json" || warn "Skipping evidence.json: response was not valid JSON"; }
        [ -n "$skill_md" ] && echo "$skill_md" > "$save_dir/SKILL.md"
        [ -n "$discovery" ] && { _json_ok "$discovery" && echo "$discovery" > "$save_dir/scoutica.json" || warn "Skipping scoutica.json: response was not valid JSON"; }
        echo ""
        success "Card saved to $save_dir/"
        
        # Resolve metadata belongs to the saved card, never the caller cwd.
        _write_resolve_state "$save_dir" "$base_url" || return 1
    fi
}

